{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"declaration": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"types": ["node", "vitest/globals"]
	},
	"include": [
		"src",
		"tools",
		"test",
		"examples/ambient-capture/**/*.ts",
		"tsup.config.ts",
		"vitest.config.ts"
	]
}
